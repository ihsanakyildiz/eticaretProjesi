model HeroSlideMedia {
  id        String        @id @default(cuid())
  slideId   String
  slide     HeroSlide     @relation(fields: [slideId], references: [id], onDelete: Cascade)
  kind      HeroMediaKind
  image     String        @db.VarChar(500)
  alt       String?       @db.VarChar(191)
  label     String?       @db.VarChar(191)
  href      String?       @db.VarChar(500)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([slideId, kind, sortOrder])
  @@map("hero_slide_media")
}

enum CardMediaType {
  IMAGE
  ICON
}

enum CardType {
  CLASSIC
  ADVANCED
}

/// Görselin içeriğe göre konumu (gelişmiş kart)
enum CardLayout {
  MEDIA_LEFT
  MEDIA_RIGHT
  MEDIA_TOP
  MEDIA_BOTTOM
}

/// Ön yüz kartları — klasik (ikon/görsel) veya gelişmiş (neden biz / split layout)
model Card {
  id        String        @id @default(cuid())
  type      CardType      @default(CLASSIC)
  title     String        @db.VarChar(191)
  /// Gelişmiş kartta bölüm rozeti (örn. Neden Biz)
  badgeText String?       @db.VarChar(120)
  /// Gelişmiş kartta sağ/sol metin başlığı
  subtitle  String?       @db.VarChar(255)
  /// Zengin metin açıklama (HTML)
  description String?     @db.LongText
  /// JSON dizi: ["özellik 1", "özellik 2"]
  features  String?       @db.Text
  layout    CardLayout    @default(MEDIA_LEFT)
  mediaType CardMediaType @default(ICON)
  /// Kapak / yan görsel
  image     String?       @db.VarChar(500)
  /// Lucide ikon adı — klasik kart (mediaType = ICON)
  icon      String?       @db.VarChar(100)
  /// Çerçeve + sparkle (gelişmiş)
  showFrame    Boolean    @default(true)
  showSparkles Boolean    @default(true)
  videoLabel   String?    @db.VarChar(100)
  videoUrl     String?    @db.VarChar(500)
  profileName  String?    @db.VarChar(120)
  profileRole  String?    @db.VarChar(120)
  profileImage String?    @db.VarChar(500)
  statValue    String?    @db.VarChar(40)
  statLabel    String?    @db.VarChar(100)
  /// Kart / CTA linki
  href         String            @default("#") @db.VarChar(500)
  isActive     Boolean           @default(true)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sectionLinks PageSectionCard[]

  @@index([type, isActive, sortOrder])
  @@index([isActive, sortOrder])
  @@map("cards")
}

/// SSS grubu — farklı sayfalarda kullanılabilir
model FaqGroup {
  id          String    @id @default(cuid())
  name        String    @db.VarChar(191)
  slug        String    @unique @db.VarChar(191)
  description String?   @db.Text
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  items        FaqItem[]
  projects     Project[]
  pageSections PageSection[]

  @@index([isActive, sortOrder])
  @@map("faq_groups")
}

/// SSS grubuna ait soru-cevap
model FaqItem {
  id        String   @id @default(cuid())
  groupId   String
  group     FaqGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  question  String   @db.VarChar(500)
  answer    String   @db.LongText
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId, sortOrder])
  @@index([groupId, isActive])
  @@map("faq_items")
}

/// Fiyatlandırma paketleri — anasayfa / gelişmiş sayfa PRICING bölümü
enum PricingPriceType {
  FIXED
  RANGE
  QUOTE
}

/// Fiyatlandırma paketleri — anasayfa / gelişmiş sayfa PRICING bölümü
model PricingPlan {
  id                    String                   @id @default(cuid())
  name                  String                   @db.VarChar(191)
  slug                  String                   @unique @db.VarChar(191)
  blurb                 String?                  @db.VarChar(255)
  /// Detay sayfası zengin metin (HTML)
  detailContent         String?                  @db.LongText
  /// Detay sayfası kapak görseli
  coverImage            String?                  @db.VarChar(500)
  /// Sabit fiyat gösterimi
  priceType             PricingPriceType         @default(FIXED)
  /// RANGE: alt sınır · QUOTE: kullanılmaz
  priceRangeMin         String?                  @db.VarChar(80)
  /// RANGE: üst sınır
  priceRangeMax         String?                  @db.VarChar(80)
  priceMonthly          String                   @db.VarChar(80)
  priceYearly           String                   @db.VarChar(80)
  /// Doluysa sitede liste fiyatı üstü çizili, bu değer asıl fiyat olur
  priceMonthlyDiscount  String?                  @db.VarChar(80)
  priceYearlyDiscount   String?                  @db.VarChar(80)
  /// false ise fiyat yanında /ay /yıl gösterilmez (örn. Ücretsiz)
  showPeriod            Boolean                  @default(true)
  featured              Boolean                  @default(false)
  /// JSON: [{ "label": string, "included": boolean }]
  features              String?                  @db.Text
  ctaLabel              String                   @default("Başlayın") @db.VarChar(100)
  ctaHref               String                   @default("/iletisim") @db.VarChar(500)
  purchasable           Boolean                  @default(false)
  stripePriceIdMonthly  String?                  @db.VarChar(191)
  stripePriceIdYearly   String?                  @db.VarChar(191)
  isActive              Boolean                  @default(true)
  sortOrder             Int                      @default(0)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  subscriptions         MembershipSubscription[]

  @@index([isActive, sortOrder])
  @@map("pricing_plans")
}

/// Ürün kategorileri — sınırsız alt kategori
model ProductCategory {
  id             String            @id @default(cuid())
  parentId       String?
  parent         ProductCategory?  @relation("ProductCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       ProductCategory[] @relation("ProductCategoryTree")
  name           String            @db.VarChar(191)
  slug           String            @unique @db.VarChar(191)
  urlId          Int               @unique @default(autoincrement())
  description    String?           @db.Text
  image          String?           @db.VarChar(500)
  isActive       Boolean           @default(true)
  sortOrder      Int               @default(0)
  seoTitle       String?           @db.VarChar(191)
  seoDescription String?           @db.VarChar(500)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  products       Product[]
  filterLinks    ProductFilterCategory[]
  pageSections   PageSection[]
  listedInSections PageSectionProductCategory[]
  menuItems      MenuItem[]

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("product_categories")
}

/// Tedarikçi firma — ürünler bu kayda bağlanır
model Supplier {
  id          String    @id @default(cuid())
  name        String    @db.VarChar(191)
  slug        String    @unique @db.VarChar(191)
  /// Resmi unvan
  legalName   String?   @db.VarChar(191)
  taxNumber   String?   @db.VarChar(50)
  taxOffice   String?   @db.VarChar(191)
  contactName String?   @db.VarChar(191)
  email       String?   @db.VarChar(191)
  phone       String?   @db.VarChar(50)
  phone2      String?   @db.VarChar(50)
  whatsapp    String?   @db.VarChar(50)
  website     String?   @db.VarChar(500)
  address     String?   @db.Text
  city        String?   @db.VarChar(100)
  district    String?   @db.VarChar(100)
  country     String?   @db.VarChar(100)
  postalCode  String?   @db.VarChar(20)
  logo        String?   @db.VarChar(500)
  /// Firma tanıtımı (HTML)
  description String?   @db.LongText
  /// Tedarik ettiği ürün / kategori bilgisi (HTML)
  productInfo String?   @db.LongText
  /// Yalnızca admin notu
  notes       String?   @db.Text
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([isActive, sortOrder])
  @@index([name])
  @@map("suppliers")
}

/// Vitrin markası — ürünler bu kayda bağlanır
model Brand {
  id             String    @id @default(cuid())
  name           String    @db.VarChar(191)
  slug           String    @unique @db.VarChar(191)
  urlId          Int       @unique @default(autoincrement())
  tagline        String?   @db.VarChar(191)
  website        String?   @db.VarChar(500)
  /// Menşei ülke
  country        String?   @db.VarChar(100)
  logo           String?   @db.VarChar(500)
  banner         String?   @db.VarChar(500)
  description    String?   @db.LongText
  seoTitle       String?   @db.VarChar(191)
  seoDescription String?   @db.VarChar(500)
  /// Yalnızca admin notu
  notes          String?   @db.Text
  isActive       Boolean   @default(true)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  products       Product[]
  pageSections   PageSection[]

  @@index([isActive, sortOrder])
  @@index([name])
  @@map("brands")
}

/// Varyant ekseni vitrin tipi — TEXT: select · BUTTON: kutu · COLOR: nokta · IMAGE: desen
enum ProductAttributeDisplayType {
  TEXT
  COLOR
  IMAGE
  BUTTON
}

/// Global varyant özelliği (Beden, Renk). Ürüne bağlanan SKU bu değerlerden oluşur.
model ProductAttribute {
  id          String                       @id @default(cuid())
  name        String                       @db.VarChar(191)
  slug        String                       @unique @db.VarChar(191)
  description String?                      @db.Text
  displayType ProductAttributeDisplayType  @default(TEXT)
  isActive    Boolean                      @default(true)
  sortOrder   Int                          @default(0)
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  values      ProductAttributeValue[]
  selections  ProductVariantSelection[]
  filter      ProductFilter?

  @@index([isActive, sortOrder])
  @@map("product_attributes")
}

/// Özellik değeri (42, Siyah). Stok bu değerde değil; SKU kombinasyonundadır.
model ProductAttributeValue {
  id          String         @id @default(cuid())
  attributeId String
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  name        String         @db.VarChar(191)
  slug        String         @db.VarChar(191)
  /// COLOR tipi için #RRGGBB
  colorHex    String?        @db.VarChar(20)
  /// IMAGE tipi için swatch
  image       String?        @db.VarChar(500)
  isActive    Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  selections  ProductVariantSelection[]

  @@unique([attributeId, slug])
  @@index([attributeId, sortOrder])
  @@index([attributeId, isActive])
  @@map("product_attribute_values")
}

/// Filtre kaynağı. CUSTOM: ürün spec · VARIANT: SKU seçenekleri · SYSTEM: marka/fiyat/stok
enum ProductFilterKind {
  CUSTOM
  VARIANT
  SYSTEM
}

/// Yerleşik vitrin filtreleri — değerleri başka tablolardan gelir
enum ProductFilterSystemKey {
  BRAND
  PRICE
  AVAILABILITY
}

/// Vitrin kontrolü. Magento/Amazon: gruplar arası AND, grup içi OR.
enum ProductFilterInputType {
  MULTI_SELECT
  SWATCH
  BOOLEAN
  RANGE
}

/// Vitrin faset tanımı. Varyant değerleri tekrarlanmaz; VARIANT kaynağı ProductAttribute’a bağlanır.
model ProductFilter {
  id                 String                 @id @default(cuid())
  name               String                 @db.VarChar(191)
  slug               String                 @unique @db.VarChar(191)
  description        String?                @db.Text
  kind               ProductFilterKind
  systemKey          ProductFilterSystemKey?
  variantAttributeId String?                @unique
  variantAttribute   ProductAttribute?      @relation(fields: [variantAttributeId], references: [id], onDelete: Restrict)
  inputType          ProductFilterInputType
  /// RANGE için birim (cm, GB, inç)
  unit               String?                @db.VarChar(20)
  /// Magento: Filterable (with results)
  hideEmptyValues    Boolean                @default(true)
  showProductCount   Boolean                @default(true)
  /// true: tüm kategorilerde görünür
  appliesGlobally    Boolean                @default(false)
  /// Atanan kategorinin alt kategorilerine de uygula
  inheritToChildren  Boolean                @default(true)
  isActive           Boolean                @default(true)
  sortOrder          Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  values             ProductFilterValue[]
  categories         ProductFilterCategory[]
  assignments        ProductFilterAssignment[]

  @@unique([systemKey])
  @@index([isActive, sortOrder])
  @@index([kind, isActive])
  @@map("product_filters")
}

model ProductFilterValue {
  id          String                    @id @default(cuid())
  filterId    String
  filter      ProductFilter             @relation(fields: [filterId], references: [id], onDelete: Cascade)
  name        String                    @db.VarChar(191)
  slug        String                    @db.VarChar(191)
  colorHex    String?                   @db.VarChar(20)
  image       String?                   @db.VarChar(500)
  numberValue Decimal?                  @db.Decimal(12, 2)
  isActive    Boolean                   @default(true)
  sortOrder   Int                       @default(0)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  assignments ProductFilterAssignment[]
  pageSections PageSection[]

  @@unique([filterId, slug])
  @@index([filterId, sortOrder])
  @@index([filterId, isActive])
  @@map("product_filter_values")
}

model ProductFilterCategory {
  filterId   String
  filter     ProductFilter    @relation(fields: [filterId], references: [id], onDelete: Cascade)
  categoryId String
  category   ProductCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([filterId, categoryId])
  @@index([categoryId])
  @@map("product_filter_categories")
}

/// Ürün düzeyi CUSTOM değerleri. VARIANT/SYSTEM kaynakları ürün satırına yazılmaz.
model ProductFilterAssignment {
  id           String              @id @default(cuid())
  productId    String
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  filterId     String
  filter       ProductFilter       @relation(fields: [filterId], references: [id], onDelete: Cascade)
  valueId      String?
  value        ProductFilterValue? @relation(fields: [valueId], references: [id], onDelete: Cascade)
  numberValue  Decimal?            @db.Decimal(12, 2)
  booleanValue Boolean?

  @@index([productId, filterId])
  @@index([filterId, valueId])
  @@index([filterId, booleanValue])
  @@map("product_filter_assignments")
}

enum ProductVisibility {
  EVERYWHERE
  CATALOG
  SEARCH
  NONE
}

enum ProductOutOfStockBehavior {
  DENY
  ALLOW
  DEFAULT
}

enum ProductEstimatedDelivery {
  SAME_DAY
  DAYS_1_3
  DAYS_3_5
  DAYS_5_10
}

/// Ürün fiyatlandırmasında seçilen KDV oranı.
model TaxRate {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(191)
  percent   Int
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([percent])
  @@index([isActive, sortOrder])
  @@map("tax_rates")
}

/// Satış birimi — sipariş miktarı bu birime göre yorumlanır
enum ProductSaleUnit {
  PIECE
  KG
  METER
  LITER
  PACK
}

/// Vitrin kaydı. Satın alınabilir birim ve stok ProductVariant üzerindedir (Shopify kuralı).
model Product {
  id                  String                     @id @default(cuid())
  categoryId          String?
  category            ProductCategory?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierId          String?
  supplier            Supplier?                  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  brandId             String?
  brand               Brand?                     @relation(fields: [brandId], references: [id], onDelete: SetNull)
  title               String                     @db.VarChar(191)
  slug                String                     @unique @db.VarChar(191)
  urlId               Int                        @unique @default(autoincrement())
  summary             String?                    @db.Text
  content             String?                    @db.LongText
  image               String?                    @db.VarChar(500)
  /// Katalog referansı (varsayılan SKU ile senkron)
  sku                 String?                    @unique @db.VarChar(191)
  mpn                 String?                    @db.VarChar(64)
  upc                 String?                    @db.VarChar(64)
  gtin                String?                    @db.VarChar(64)
  isbn                String?                    @db.VarChar(32)
  /// KDV hariç taban satış (kuruş) — yeni kombinasyonlar bundan türer
  basePriceMinor      Int                        @default(0)
  compareAtMinor      Int?
  costMinor           Int?
  taxRatePercent      Int                        @default(20)
  widthCm             Decimal?                   @db.Decimal(8, 2)
  heightCm            Decimal?                   @db.Decimal(8, 2)
  depthCm             Decimal?                   @db.Decimal(8, 2)
  weightKg            Decimal?                   @db.Decimal(8, 3)
  extraShippingMinor  Int                        @default(0)
  estimatedDelivery   ProductEstimatedDelivery?
  visibility          ProductVisibility          @default(EVERYWHERE)
  availableForOrder   Boolean                    @default(true)
  showPrice           Boolean                    @default(true)
  onlineOnly          Boolean                    @default(false)
  onSale              Boolean                    @default(false)
  outOfStockBehavior  ProductOutOfStockBehavior  @default(DEFAULT)
  inStockLabel        String?                    @db.VarChar(191)
  outOfStockLabel     String?                    @db.VarChar(191)
  saleUnit            ProductSaleUnit            @default(PIECE)
  minOrderQty         Int                        @default(1)
  quantityStep        Int                        @default(1)
  isActive            Boolean                    @default(true)
  sortOrder           Int                        @default(0)
  viewCount           Int                        @default(0)
  clickCount          Int                        @default(0)
  seoTitle            String?                    @db.VarChar(191)
  seoDescription      String?                    @db.VarChar(500)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  variants            ProductVariant[]
  filterAssignments   ProductFilterAssignment[]
  images              ProductImage[]
  attachments         ProductAttachment[]
  relatedFrom         ProductRelated[]           @relation("ProductRelatedFrom")
  relatedTo           ProductRelated[]           @relation("ProductRelatedTo")
  orderItems          OrderItem[]
  sectionLinks        PageSectionProduct[]

  @@index([categoryId])
  @@index([supplierId])
  @@index([brandId])
  @@index([isActive, sortOrder])
  @@index([viewCount])
  @@index([clickCount])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String   @db.VarChar(500)
  alt       String?  @db.VarChar(191)
  isCover   Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
  @@map("product_images")
}

/// Ürün ek dosyası (kılavuz, teknik şartname)
model ProductAttachment {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String   @db.VarChar(500)
  name      String   @db.VarChar(191)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
  @@map("product_attachments")
}

/// Vitrinde “ilgili ürünler”
model ProductRelated {
  productId String
  relatedId String
  product   Product @relation("ProductRelatedFrom", fields: [productId], references: [id], onDelete: Cascade)
  related   Product @relation("ProductRelatedTo", fields: [relatedId], references: [id], onDelete: Cascade)
  sortOrder Int     @default(0)

  @@id([productId, relatedId])
  @@index([relatedId])
  @@map("product_related")
}

/// Satılabilir SKU. Fiyat, barkod ve stok burada; ürün-stok eşlemesi bu satırdır.
model ProductVariant {
  id             String                    @id @default(cuid())
  productId      String
  product        Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String                    @unique @db.VarChar(191)
  barcode        String?                   @db.VarChar(64)
  /// Örn. Siyah / 42 — seçimlerden üretilir
  title          String                    @db.VarChar(191)
  /// Satış fiyatı kuruş
  priceMinor     Int
  compareAtMinor Int?
  stockQuantity  Int                       @default(0)
  trackInventory Boolean                   @default(true)
  allowBackorder Boolean                   @default(false)
  isActive       Boolean                   @default(true)
  /// Varyantsız ürünün tek SKU’su
  isDefault      Boolean                   @default(false)
  image          String?                   @db.VarChar(500)
  /// Sıralı attributeId:valueId|... — aynı kombinasyon üründe tek olabilir
  combinationKey String                    @db.VarChar(500)
  sortOrder      Int                       @default(0)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  selections     ProductVariantSelection[]
  orderItems     OrderItem[]

  @@unique([productId, combinationKey])
  @@index([productId, isActive])
  @@index([productId, isDefault])
  @@map("product_variants")
}

/// Bir SKU’nun özellik seçimleri. Silme, kullanımda Restrict.
model ProductVariantSelection {
  variantId   String
  variant     ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   ProductAttribute      @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  valueId     String
  value       ProductAttributeValue @relation(fields: [valueId], references: [id], onDelete: Restrict)

  @@id([variantId, attributeId])
  @@unique([variantId, valueId])
  @@index([attributeId])
  @@index([valueId])
  @@map("product_variant_selections")
}

enum MenuLinkType {
  CUSTOM
  PAGE
  PRODUCT_CATEGORY
  WORK_CATEGORY
  WORK
  PROJECT_CATEGORY
  PROJECT
  BLOG_CATEGORY
  BLOG_POST
}

/// Menü grubunun vitrinde görüneceği yer
enum MenuPlacement {
  NONE
  TOP
  HEADER
  FOOTER
}

/// Menü grubu — örn. Header Menü, Footer Menü
model MenuGroup {
  id          String        @id @default(cuid())
  name        String        @db.VarChar(191)
  slug        String        @unique @db.VarChar(191)
  description String?       @db.Text
  placement   MenuPlacement @default(NONE)
  isActive    Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       MenuItem[]

  @@index([isActive, sortOrder])
  @@index([placement, isActive])
  @@map("menu_groups")
}

/// Menü öğesi — CMS içeriği veya özel (mega) link; alt menü için parentId
model MenuItem {
  id       String    @id @default(cuid())
  groupId  String
  group    MenuGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  parentId String?
  parent   MenuItem? @relation("MenuItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuItemTree")

  label       String       @db.VarChar(191)
  linkType    MenuLinkType @default(CUSTOM)
  /// CUSTOM için URL; diğer tiplerde opsiyonel override
  href        String?      @db.VarChar(500)
  description String?      @db.VarChar(255)
  openInNewTab Boolean     @default(false)
  /// PRODUCT_CATEGORY: alt kategorileri mega menüde otomatik listele
  includeProductSubcategories Boolean @default(false)

  pageId            String?
  page              Page?            @relation(fields: [pageId], references: [id], onDelete: SetNull)
  productCategoryId String?
  productCategory   ProductCategory? @relation(fields: [productCategoryId], references: [id], onDelete: SetNull)
  workCategoryId    String?
  workCategory      WorkCategory?    @relation(fields: [workCategoryId], references: [id], onDelete: SetNull)
  workId            String?
  work              Work?            @relation(fields: [workId], references: [id], onDelete: SetNull)
  projectCategoryId String?
  projectCategory   ProjectCategory? @relation(fields: [projectCategoryId], references: [id], onDelete: SetNull)
  projectId         String?
  project           Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  blogCategoryId    String?
  blogCategory      BlogCategory?    @relation(fields: [blogCategoryId], references: [id], onDelete: SetNull)
  blogPostId        String?
  blogPost          BlogPost?        @relation(fields: [blogPostId], references: [id], onDelete: SetNull)

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId, parentId, sortOrder])
  @@index([groupId, isActive])
  @@map("menu_items")
}

enum MailFolder {
  INBOX
  SENT
  DRAFT
  SPAM
  TRASH
}

enum MailSource {
  CONTACT_FORM
  IMAP
  COMPOSED
  SYSTEM
}

/// Admin paneli e-posta / iletişim mesajları
model MailMessage {
  id              String     @id @default(cuid())
  folder          MailFolder @default(INBOX)
  source          MailSource @default(CONTACT_FORM)
  fromName        String     @db.VarChar(191)
  fromEmail       String     @db.VarChar(191)
  toEmail         String     @db.VarChar(191)
  replyToEmail    String?    @db.VarChar(191)
  subject         String     @db.VarChar(500)
  preview         String     @db.VarChar(500)
  bodyText        String     @db.Text
  bodyHtml        String?    @db.LongText
  isRead          Boolean    @default(false)
  isStarred       Boolean    @default(false)
  hasAttachment   Boolean    @default(false)
  /// Yanıt zinciri (cevaplanan mesaj)
  parentId        String?
  parent          MailMessage?  @relation("MailThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies         MailMessage[] @relation("MailThread")
  attachments     MailAttachment[]
  /// Etiket: updates | important | personal | private | contact
  label           String?    @db.VarChar(50)
  externalId      String?    @unique @db.VarChar(191)
  receivedAt      DateTime   @default(now())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([folder, receivedAt])
  @@index([isStarred, receivedAt])
  @@index([isRead, folder])
  @@index([label])
  @@map("mail_messages")
}

model MailAttachment {
  id          String      @id @default(cuid())
  messageId   String
  message     MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename    String      @db.VarChar(255)
  mimeType    String      @db.VarChar(127)
  size        Int         @default(0)
  contentId   String?     @db.VarChar(191)
  isInline    Boolean     @default(false)
  storagePath String      @db.VarChar(500)
  createdAt   DateTime    @default(now())

  @@index([messageId])
  @@map("mail_attachments")
}

/// Tema sidebar konumları (WordPress widget area benzeri)
enum SidebarLocation {
  BLOG_LIST
  BLOG_DETAIL
  WORKS_LIST
  WORKS_DETAIL
  PROJECTS_LIST
  PROJECTS_DETAIL
  PAGE_DETAIL
}

enum SidebarPlacement {
  LEFT
  RIGHT
}

enum SidebarWidgetType {
  BLOG_CATEGORIES
  WORK_CATEGORIES
  PROJECT_CATEGORIES
  CONTACT_INFO
  RICH_TEXT
  IMAGE
}

/// Yönetilebilir site sidebar’ı
model SiteSidebar {
  id          String           @id @default(cuid())
  name        String           @db.VarChar(191)
  slug        String           @unique @db.VarChar(191)
  description String?          @db.Text
  /// Boşsa yalnızca taslak / kullanılabilir; doluysa ilgili alanda gösterilir
  location    SidebarLocation?
  /// İçeriğin solunda veya sağında gösterim
  placement   SidebarPlacement @default(LEFT)
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  widgets     SiteSidebarWidget[]

  @@index([isActive, sortOrder])
  @@index([location, isActive])
  @@map("site_sidebars")
}

/// Sidebar içindeki widget / blok
model SiteSidebarWidget {
  id        String            @id @default(cuid())
  sidebarId String
  sidebar   SiteSidebar       @relation(fields: [sidebarId], references: [id], onDelete: Cascade)
  type      SidebarWidgetType
  title     String?           @db.VarChar(191)
  /// RICH_TEXT HTML içeriği
  content   String?           @db.LongText
  imagePath String?           @db.VarChar(500)
  imageAlt  String?           @db.VarChar(191)
  /// JSON ayarlar (iletişim alanları, sayaç, link vb.)
  settings  String?           @db.Text
  isActive  Boolean           @default(true)
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([sidebarId, sortOrder])
  @@index([sidebarId, isActive])
  @@map("site_sidebar_widgets")
}

/// Bilinen kargo API entegrasyonları; CUSTOM = elle tanımlı firma
enum ShippingCarrierProvider {
  CUSTOM
  YURTICI
  ARAS
  MNG
  PTT
  SURAT
  UPS
  DHL
  FEDEX
  HOROZ
  HEPSIJET
  TRENDYOL_EXPRESS
  KOLAY_GELSIN
  SENDEO
}

/// Mağazada seçilebilecek kargo firması (API alanları sonraki entegrasyon için)
model ShippingCarrier {
  id                  String                   @id @default(cuid())
  name                String                   @db.VarChar(191)
  slug                String                   @unique @db.VarChar(191)
  provider            ShippingCarrierProvider  @default(CUSTOM)
  trackingUrlTemplate String?                  @db.VarChar(500)
  website             String?                  @db.VarChar(500)
  phone               String?                  @db.VarChar(50)
  email               String?                  @db.VarChar(191)
  logo                String?                  @db.VarChar(500)
  notes               String?                  @db.Text
  /// İleride API kimlik bilgileri / entegrasyon ayarları (JSON)
  apiSettings         String?                  @db.Text
  isActive            Boolean                  @default(true)
  sortOrder           Int                      @default(0)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([isActive, sortOrder])
  @@index([provider])
  @@map("shipping_carriers")
}

enum ProductImportJobStatus {
  PREVIEW
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum ProductImportRowKind {
  READY
  ZERO_PRICE
  ERROR
}

enum ProductImportRowWork {
  PENDING
  IMPORTED
  FAILED
}

model ProductImportJob {
  id             String                 @id @default(cuid())
  fileName       String                 @db.VarChar(255)
  fileSize       Int
  status         ProductImportJobStatus @default(PREVIEW)
  rowCount       Int                    @default(0)
  readyCount     Int                    @default(0)
  zeroPriceCount Int                    @default(0)
  errorCount     Int                    @default(0)
  importedCount  Int                    @default(0)
  failedCount    Int                    @default(0)
  currentTitle   String?                @db.VarChar(191)
  currentRow     Int?
  error          String?                @db.VarChar(500)
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  rows           ProductImportJobRow[]

  @@index([status, createdAt])
  @@map("product_import_jobs")
}

model ProductImportJobRow {
  id        String               @id @default(cuid())
  jobId     String
  job       ProductImportJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rowNumber Int
  title     String               @db.VarChar(191)
  category  String               @db.VarChar(191)
  sku       String               @db.VarChar(80)
  barcode   String               @db.VarChar(64)
  price     String               @db.VarChar(40)
  stock     String               @db.VarChar(20)
  kind      ProductImportRowKind
  work      ProductImportRowWork @default(PENDING)
  errors    String               @default("") @db.VarChar(1000)
  rawJson   String               @db.LongText
  productId String?

  @@index([jobId, kind, rowNumber])
  @@index([jobId, work, rowNumber])
  @@map("product_import_job_rows")
}
