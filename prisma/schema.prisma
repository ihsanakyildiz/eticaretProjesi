enum ApiFeedAuthType {
  NONE
  BEARER
  BASIC
  HEADER
  QUERY
}

/// Tedarikçi JSON API ürün beslemesi — XML kaynaklarıyla aynı katalog kuralları
model ApiProductFeed {
  id                 String            @id @default(cuid())
  name               String            @db.VarChar(191)
  url                String            @db.VarChar(1000)
  isActive           Boolean           @default(true)
  supplierId         String?
  supplier           Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  defaultCategoryId  String?           @db.VarChar(191)
  defaultBrandId     String?           @db.VarChar(191)
  itemPath           String            @default("") @db.VarChar(500)
  mappingJson        String            @db.LongText
  categoryMapJson    String            @db.LongText
  requestJson        String            @db.LongText
  matchBy            XmlFeedMatchBy    @default(BARCODE)
  skuPrefix          String            @default("") @db.VarChar(40)
  httpUser           String?           @db.VarChar(191)
  httpPass           String?           @db.Text
  httpMethod         ApiFeedHttpMethod @default(GET)
  authType           ApiFeedAuthType   @default(NONE)
  createNew          Boolean           @default(true)
  updatePrice        Boolean           @default(true)
  updateStock        Boolean           @default(true)
  updateImages       Boolean           @default(false)
  updateContent      Boolean           @default(false)
  updateTitle        Boolean           @default(false)
  deactivateMissing  Boolean           @default(false)
  priceIncludesTax   Boolean           @default(true)
  priceMarkupPercent Decimal           @default(0) @db.Decimal(8, 2)
  priceRound         XmlFeedPriceRound @default(NONE)
  intervalMinutes    Int               @default(60)
  lastRunAt          DateTime?
  nextRunAt          DateTime?
  lastStatus         String?           @db.VarChar(40)
  lastMessage        String?           @db.VarChar(500)
  lastCreatedCount   Int               @default(0)
  lastUpdatedCount   Int               @default(0)
  lastSkippedCount   Int               @default(0)
  lastFailedCount    Int               @default(0)
  sortOrder          Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  runs               ApiProductFeedRun[]

  @@index([isActive, nextRunAt])
  @@index([supplierId])
  @@map("api_product_feeds")
}

model ApiProductFeedRun {
  id                 String           @id @default(cuid())
  feedId             String
  feed               ApiProductFeed   @relation(fields: [feedId], references: [id], onDelete: Cascade)
  status             XmlFeedRunStatus @default(QUEUED)
  itemCount          Int              @default(0)
  createdCount       Int              @default(0)
  updatedCount       Int              @default(0)
  skippedCount       Int              @default(0)
  failedCount        Int              @default(0)
  deactivatedCount   Int              @default(0)
  cursor             Int              @default(0)
  seenIdsJson        String           @default("[]") @db.Text
  message            String?          @db.Text
  startedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime         @default(now())

  @@index([feedId, createdAt])
  @@index([status, createdAt])
  @@map("api_product_feed_runs")
}

enum StockDocumentKind {
  GOODS_RECEIPT
  PURCHASE_INVOICE
  GOODS_ISSUE
  TRANSFER
  ADJUSTMENT
  COUNT
  SUPPLIER_RETURN
  CUSTOMER_RETURN
}

enum StockDocumentStatus {
  DRAFT
  CONFIRMED
  CANCELED
}

enum StockMovementKind {
  OPENING
  RECEIPT
  ISSUE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  COUNT
  SALE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  CATALOG
}

/// Fiziksel depo (İstanbul, İzmir, Adana…). İstendiği kadar açılır.
model StockWarehouse {
  id         String   @id @default(cuid())
  code       String   @unique @db.VarChar(32)
  name       String   @db.VarChar(191)
  city       String?  @db.VarChar(100)
  district   String?  @db.VarChar(100)
  address    String?  @db.Text
  phone      String?  @db.VarChar(50)
  isActive   Boolean  @default(true)
  isDefault  Boolean  @default(false)
  sortOrder  Int      @default(0)
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  stocks     WarehouseStock[]
  locations  StockLocation[]
  documents  StockDocument[]  @relation("StockDocumentWarehouse")
  transfersIn StockDocument[] @relation("StockDocumentTargetWarehouse")
  movements  StockMovement[]

  @@index([isActive, sortOrder])
  @@index([isDefault])
  @@map("stock_warehouses")
}

/// Bir varyantın belirli depodaki fiili adedi. Katalog `stockQuantity` depoların toplamıdır.
model WarehouseStock {
  id               String         @id @default(cuid())
  warehouseId      String
  warehouse        StockWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity         Int            @default(0)
  reservedQuantity Int            @default(0)
  locationId       String?
  location         StockLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  updatedAt        DateTime       @updatedAt

  @@unique([warehouseId, variantId])
  @@index([variantId])
  @@index([warehouseId, quantity])
  @@index([locationId])
  @@map("warehouse_stocks")
}

/// Depo içi adres: koridor / raf / göz. Sipariş toplamada ürün buradan bulunur.
model StockLocation {
  id          String         @id @default(cuid())
  warehouseId String
  warehouse   StockWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  code        String         @db.VarChar(32)
  aisle       String?        @db.VarChar(16)
  rack        String?        @db.VarChar(16)
  shelf       String?        @db.VarChar(16)
  notes       String?        @db.VarChar(255)
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  stocks      WarehouseStock[]

  @@unique([warehouseId, code])
  @@index([warehouseId, sortOrder])
  @@index([warehouseId, isActive])
  @@map("stock_locations")
}

model StockDocument {
  id                 String              @id @default(cuid())
  kind               StockDocumentKind
  status             StockDocumentStatus @default(DRAFT)
  number             String              @unique @db.VarChar(32)
  warehouseId        String
  warehouse          StockWarehouse      @relation("StockDocumentWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict)
  targetWarehouseId  String?
  targetWarehouse    StockWarehouse?     @relation("StockDocumentTargetWarehouse", fields: [targetWarehouseId], references: [id], onDelete: Restrict)
  supplierId         String?
  supplier           Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  orderId            String?
  order              Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  relatedDocumentId  String?
  relatedDocument    StockDocument?      @relation("StockDocumentLink", fields: [relatedDocumentId], references: [id], onDelete: SetNull)
  relatedDocuments   StockDocument[]     @relation("StockDocumentLink")
  externalNumber     String?             @db.VarChar(64)
  documentDate       DateTime            @default(now())
  dueDate            DateTime?
  notes              String?             @db.Text
  createdById        String?
  createdBy          User?               @relation("StockDocumentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  confirmedAt        DateTime?
  confirmedById      String?
  confirmedBy        User?               @relation("StockDocumentConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  canceledAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lines              StockDocumentLine[]
  movements          StockMovement[]

  @@index([kind, status, documentDate])
  @@index([warehouseId, status])
  @@index([supplierId])
  @@index([orderId])
  @@index([relatedDocumentId])
  @@map("stock_documents")
}

model StockDocumentLine {
  id            String         @id @default(cuid())
  documentId    String
  document      StockDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity      Int
  unitCostMinor Int?
  notes         String?        @db.VarChar(255)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([documentId, sortOrder])
  @@index([variantId])
  @@map("stock_document_lines")
}

model StockMovement {
  id            String            @id @default(cuid())
  warehouseId   String
  warehouse     StockWarehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variantId     String
  variant       ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  documentId    String?
  document      StockDocument?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  orderId       String?
  order         Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  kind          StockMovementKind
  quantity      Int
  balanceAfter  Int
  note          String?           @db.VarChar(255)
  createdById   String?
  createdBy     User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())

  @@index([warehouseId, createdAt])
  @@index([variantId, createdAt])
  @@index([documentId])
  @@index([orderId])
  @@index([kind, createdAt])
  @@map("stock_movements")
}

enum CampaignKind {
  PERCENT_OFF
  FIXED_OFF
  FREE_SHIPPING
  CART_PERCENT
}

enum CampaignStatus {
  ACTIVE
  DISABLED
}

/// Toplu ürün kampanyası (yüzde, tutar, kargo, sepet indirimi)
model Campaign {
  id          String         @id @default(cuid())
  name        String         @db.VarChar(191)
  kind        CampaignKind
  valueInt    Int            @default(0)
  status      CampaignStatus @default(ACTIVE)
  countdown   Boolean        @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  inStockOnly Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  products    CampaignProduct[]
  categories  CampaignCategory[]
  brands      CampaignBrand[]

  @@index([status, startsAt, endsAt])
  @@index([createdAt])
  @@map("campaigns")
}

model CampaignCategory {
  campaignId String
  categoryId String
  campaign   Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([campaignId, categoryId])
  @@index([categoryId])
  @@map("campaign_categories")
}

model CampaignBrand {
  campaignId String
  brandId    String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([campaignId, brandId])
  @@index([brandId])
  @@map("campaign_brands")
}

model CampaignProduct {
  id           String    @id @default(cuid())
  campaignId   String
  productId    String
  snapshotJson String    @db.LongText
  restoredAt   DateTime?
  createdAt    DateTime  @default(now())
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
  @@index([productId])
  @@index([restoredAt])
  @@map("campaign_products")
}

model SiteModule {
  id          String    @id @default(cuid())
  moduleId    String    @unique @db.VarChar(64)
  licenseKey  String    @db.Text
  status      String    @default("INACTIVE") @db.VarChar(20)
  activatedAt DateTime?
  expiresAt   DateTime?
  payloadJson String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@map("site_modules")
}

model SupportChatAccount {
  id              String   @id @default(cuid())
  channel         String   @db.VarChar(32)
  name            String   @db.VarChar(191)
  externalId      String   @default("") @db.VarChar(191)
  status          String   @default("ACTIVE") @db.VarChar(20)
  credentialsJson String   @db.LongText
  webhookSecret   String?  @db.VarChar(191)
  departmentId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([channel])
  @@index([status])
  @@index([departmentId])
  @@map("support_chat_accounts")
}

model SupportChatTag {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(80)
  color     String   @default("#405189") @db.VarChar(16)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("support_chat_tags")
}

model SupportChatDepartment {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(80)
  color     String   @default("#405189") @db.VarChar(16)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  staff     SupportChatStaffDepartment[]

  @@map("support_chat_departments")
}

model SupportChatStaffDepartment {
  userId       String
  departmentId String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   SupportChatDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@index([departmentId])
  @@map("support_chat_staff_departments")
}

model SupportChatCannedReply {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(120)
  body      String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("support_chat_canned_replies")
}

model SupportChatConversation {
  id                 String    @id @default(cuid())
  accountId          String
  channel            String    @db.VarChar(32)
  externalThreadId   String    @default("") @db.VarChar(191)
  customerName       String    @db.VarChar(191)
  customerHandle     String?   @db.VarChar(191)
  customerAvatar     String?   @db.VarChar(500)
  lastMessageAt      DateTime?
  lastMessagePreview String    @default("") @db.VarChar(280)
  unreadCount        Int       @default(0)
  assignedUserId     String?
  departmentId       String?
  status             String    @default("OPEN") @db.VarChar(20)
  handledBy          String    @default("HUMAN") @db.VarChar(20)
  folder             String    @default("INBOX") @db.VarChar(20)
  sourceUrl          String?   @db.VarChar(500)
  sourceTitle        String?   @db.VarChar(191)
  sourceImage        String?   @db.VarChar(500)
  customerUserId     String?
  customerUser       User?     @relation("SupportChatCustomer", fields: [customerUserId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([accountId])
  @@index([accountId, externalThreadId])
  @@index([assignedUserId])
  @@index([departmentId])
  @@index([customerUserId])
  @@index([lastMessageAt])
  @@index([folder])
  @@map("support_chat_conversations")
}

model SupportChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  direction      String   @db.VarChar(8)
  body           String   @db.Text
  mediaJson      String?  @db.LongText
  externalId     String?  @db.VarChar(191)
  sentAt         DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([conversationId])
  @@index([externalId])
  @@map("support_chat_messages")
}

model SupportChatNote {
  id             String   @id @default(cuid())
  conversationId String
  staffUserId    String?
  body           String   @db.Text
  createdAt      DateTime @default(now())

  @@index([conversationId])
  @@map("support_chat_notes")
}

model SupportChatConversationTag {
  conversationId String
  tagId          String

  @@id([conversationId, tagId])
  @@index([tagId])
  @@map("support_chat_conversation_tags")
}

model SupportChatSetting {
  settingKey   String   @id @db.VarChar(100)
  settingValue String   @db.Text
  updatedAt    DateTime @updatedAt

  @@map("support_chat_settings")
}

model SupportChatThreadBlock {
  id               String   @id @default(cuid())
  accountId        String   @db.VarChar(191)
  channel          String   @db.VarChar(32)
  externalThreadId String   @db.VarChar(191)
  blockedAt        DateTime @default(now())
  cutoffMs         BigInt?

  @@unique([accountId, externalThreadId])
  @@index([blockedAt])
  @@map("support_chat_thread_blocks")
}

model SupportChatIgnoredMessage {
  externalId String   @id @db.VarChar(191)
  ignoredAt  DateTime @default(now())

  @@map("support_chat_ignored_messages")
}

model SupportChatOAuthSession {
  id           String   @id @default(cuid())
  state        String   @unique @db.VarChar(191)
  userId       String   @db.VarChar(191)
  accessToken  String   @db.Text
  assetsJson   String   @db.LongText
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
  @@map("support_chat_oauth_sessions")
}
